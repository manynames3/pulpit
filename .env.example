#
# Pulpit local ingestion (cron-friendly) configuration
#
# Copy to .env (already gitignored) and fill values.
#

# S3 bucket created by Terraform (module ingestion output)
PULPIT_TRANSCRIPT_BUCKET="pulpit-transcripts-dev-XXXXXXXXXXXX"

# YouTube channel ID to ingest from (starts with UC...)
PULPIT_YOUTUBE_CHANNEL_ID="UCxxxxxxxxxxxxxxxxxxxxxx"

# YouTube Data API v3 key (keep private)
PULPIT_YOUTUBE_API_KEY="AIzaSy..."

# Optional: only ingest videos from this year and newer (cost control)
PULPIT_YEAR_FILTER="2026"

# Optional: throttle to avoid YouTube IP blocks (cron-friendly batching)
# Increase gradually if you never see IP blocks.
PULPIT_MAX_NEW_PER_RUN="12"
PULPIT_SLEEP_SEC="2.5"

# Optional: hard cap transcript fetch attempts per run.
# Useful during first-time backfill to reduce the chance of IP blocks,
# especially if many videos have subtitles disabled.
PULPIT_MAX_TRANSCRIPT_ATTEMPTS="40"

# Optional: AWS region (should match your Terraform region)
AWS_REGION="us-east-1"
